# Optional overrides. Copy to .env locally; never commit .env.
H3_STUDIO_HOST=127.0.0.1
H3_STUDIO_PORT=8220
H3_COMFY_URL=http://127.0.0.1:8218
H3_EXPERIMENTAL_COMFY_URL=http://127.0.0.1:8218
H3_DATA_DIR=data
H3_FRONTEND_DIST=frontend/dist
H3_DIRECTOR_ENABLED=false
H3_DIRECTOR_OPENAI_MANAGED_GPU=false
H3_DIRECTOR_AUTOSTART_OLLAMA=false
# Optional Prompt Chat endpoint; not installed by Studio.
H3_DIRECTOR_OPENAI_URL=http://127.0.0.1:8083/v1
H3_DIRECTOR_OPENAI_MODEL=local-prompt-model
# Optional: H3_FFPROBE_PATH may point to ffprobe if it is not on PATH.
