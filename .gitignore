# Local runtimes and user data are not part of source control.
.env
.env.*
!.env.example
**/__pycache__/
**/*.pyc
**/.pytest_cache/
**/.venv/
**/node_modules/
*.tsbuildinfo
# Optional Omni runtime contains a private core, venv and host-local mappings.
runtime/fasth3-omni/
studio/data/
runtime/venv/
runtime/tools/
runtime/cache/
runtime/logs/
runtime/state/
runtime/ComfyUI/
runtime/extra_model_paths.yaml
runtime/tool-paths.json
runtime/install-state.json
models/diffusion_models/*.safetensors
models/text_encoders/*.safetensors
models/vae/*.safetensors
input/
output/
# LoRAs and other model weights are downloaded/reused via the pinned manifest.

# Git distribution never contains model weights or host-local configuration.
*.safetensors
*.pt
*.pth
models/**/*.bin
runtime/installed.json
runtime/model-roots.json
runtime/workstation.json
runtime/workstation-state.json
runtime/workstation-selection.json
runtime/download-receipts/
