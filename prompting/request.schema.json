{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "duration_seconds",
    "identity",
    "style",
    "assets",
    "shots",
    "audio"
  ],
  "properties": {
    "duration_seconds": {
      "type": [
        "number",
        "string"
      ],
      "description": "Nonnegative decimal seconds; runtime renderer validates precision/range."
    },
    "identity": {
      "type": "string",
      "minLength": 1
    },
    "style": {
      "type": "string",
      "minLength": 1
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "role",
          "description"
        ],
        "properties": {
          "kind": {
            "enum": [
              "image",
              "video",
              "aligned_guide"
            ]
          },
          "role": {
            "enum": [
              "identity",
              "aligned_guide",
              "motion",
              "scene",
              "costume",
              "style",
              "first_frame",
              "last_frame"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "token": {
            "type": "string",
            "pattern": "^<(Picture|Video|Audio) [1-9][0-9]*>$"
          }
        }
      }
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "start_seconds",
          "scene",
          "performance",
          "camera",
          "lighting",
          "sound"
        ],
        "properties": {
          "start_seconds": {
            "type": [
              "number",
              "string"
            ],
            "description": "Nonnegative decimal seconds; runtime renderer validates precision/range."
          },
          "scene": {
            "type": "string",
            "minLength": 1
          },
          "performance": {
            "type": "string",
            "minLength": 1
          },
          "camera": {
            "type": "string",
            "minLength": 1
          },
          "lighting": {
            "type": "string",
            "minLength": 1
          },
          "sound": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "soundscape",
        "music",
        "silent"
      ],
      "properties": {
        "soundscape": {
          "type": "string",
          "minLength": 1
        },
        "music": {
          "type": "string",
          "minLength": 1
        },
        "silent": {
          "type": "boolean"
        }
      }
    },
    "dialogue": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "shot",
          "start_seconds",
          "end_seconds",
          "speaker",
          "language",
          "text",
          "delivery"
        ],
        "properties": {
          "shot": {
            "type": "integer",
            "minimum": 1
          },
          "start_seconds": {
            "type": [
              "number",
              "string"
            ],
            "description": "Nonnegative decimal seconds; runtime renderer validates precision/range."
          },
          "end_seconds": {
            "type": [
              "number",
              "string"
            ],
            "description": "Nonnegative decimal seconds; runtime renderer validates precision/range."
          },
          "speaker": {
            "type": "string",
            "minLength": 1
          },
          "language": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "delivery": {
            "type": "string",
            "minLength": 1
          },
          "voiceover": {
            "type": "boolean"
          },
          "subject": {
            "type": "integer",
            "const": 1,
            "description": "Motion only: explicitly bind speech to the identity performer Subject 1. Omit for independent voices."
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kinjutsu:h3-prompt-form:v1",
  "title": "Kinjutsu deterministic H3 prompt form",
  "description": "Structural schema only. renderer.py validates per-template roles, exact attachment tokens, durations, chronology, audio and placeholder constraints. No external JSON Schema library is required."
}
